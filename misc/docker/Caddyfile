{
	# L'autorité locale sert au navigateur du poste (importée à la main), pas au conteneur
	skip_install_trust
}

localhost {
	# Journal des requêtes (statut, durée) en JSON sur la sortie standard, collecté par ELK
	log {
		output stdout
		format json
	}

	root * /app/front
	encode gzip
	try_files {path} /index.html
	file_server
}
